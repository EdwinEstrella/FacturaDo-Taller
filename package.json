{
  "name": "facturado",
  "version": "0.0.3",
  "private": true,
  "description": "FacturaDo Desktop Application",
  "author": "FacturaDo",
  "engines": {
    "node": ">=22.11.0"
  },
  "overrides": {
    "inflight": "^1.0.6",
    "rimraf": "^5.0.0",
    "glob": "^10.0.0",
    "boolean": "^3.2.1",
    "node-domexception": "^2.0.1"
  },
  "scripts": {
    "dev": "concurrently -k --names \"next,electron\" -c \"blue,magenta\" \"next dev -p 3000\" \"electron .\"",
    "dev:web": "next dev",
    "dev:electron": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icon:build": "node scripts/build-icon.mjs",
    "build:standalone": "next build && node scripts/prepare-standalone.js",
    "package": "npm run icon:build && npm run build:standalone && node scripts/clean-env.cjs electron-builder --dir",
    "dist:win": "npm run icon:build && npm run build:standalone && node scripts/clean-env.cjs electron-builder --win",
    "release:win": "npm run icon:build && npm run build:standalone && node scripts/clean-env.cjs electron-builder --win --publish always",
    "build:electron": "npm run dist:win",
    "migrate:passwords": "tsx scripts/migrate-passwords.ts",
    "doctor": "npx react-doctor@latest"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.facturado.app",
    "productName": "FacturaDo",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "./scripts/after-pack-win-icon.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "FacturaDo-Install.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EdwinEstrella",
        "repo": "FacturaDo-Taller",
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ]
  },
  "dependencies": {
    "@carbon/icons-react": "^11.72.0",
    "@hookform/resolvers": "^5.2.2",
    "@insforge/cli": "^0.1.91",
    "@insforge/sdk": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-to-print": "^3.2.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "rcedit": "^5.0.2",
    "shadcn": "^3.6.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  }
}
